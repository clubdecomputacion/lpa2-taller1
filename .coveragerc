[run]
source = src
# */ui/*: interfaz interactiva de consola (rich), fuera del alcance de los entregables
omit =
    */__pycache__/*
    */tests/*
    */venv/*
    */migrations/*
    */ui/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    pass

fail_under = 80
